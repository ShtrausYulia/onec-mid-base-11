#Область СлужебныеПроцедурыИФункции
// {{ Штраус Ю.В. - Служебные процедуры, расчитать сумму строки 

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
	ПроцентСкидки = ?(ЗначениеЗаполнено(Объект.СогласованнаяСкидка), Объект.СогласованнаяСкидка, 0);
	СкидкаСтроки = ?(ЗначениеЗаполнено(ТекущиеДанные.Скидка), ТекущиеДанные.Скидка, 0);
	ПроцентСкидки = ПроцентСкидки + СкидкаСтроки;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * (1 - ПроцентСкидки / 100);
	
	Если ПроцентСкидки > 100 Тогда
		ПроцентСкидки = 100;
		ПоказатьПредупреждение(, "Внимание! Суммарная скидка превышает 100%. Расчет выполнен по максимальной ставке 100%.");
	КонецЕсли;
	
	// итог расчета суммы строки
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * (1 - ПроцентСкидки / 100);
	
	
	
	РассчитатьСуммуДокумента();
	
	
КонецПроцедуры  

// }}

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

