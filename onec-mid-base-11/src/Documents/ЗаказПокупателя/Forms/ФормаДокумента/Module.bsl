// {{ Штраус Ю.В. - Доработка интерфейса, согласованная скидка 

&НаКлиенте
Процедура СогласованнаяСкидкаПриИзменении(Элемент)
	
	// Если таблицы пустые
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Асинхронный вопрос пользователю
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПересчете", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Пересчитать цены и суммы в табличной части с учетом согласованной скидки?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПересчете(РезультатВопроса, ДополнительныеПараметры) Экспорт
	// Обработка ответа пользователя
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВыполнитьПересчетВсехСтрокДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьПоСкидке(Команда)
	
	ВыполнитьПересчетВсехСтрокДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПересчетВсехСтрокДокумента()
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТовара);
	КонецЦикла;
	
	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаУслуги);
	КонецЦикла;
	
КонецПроцедуры

// }}

